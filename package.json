{
  "name": "codriver",
  "version": "0.4.4",
  "description": "Racing-game telemetry dashboard for a second monitor, phone or tablet",
  "type": "module",
  "license": "Unlicense",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "replay": "node tools/replay.js test/fixtures/dirt3-2026-11-13.csv --loop",
    "test": "node --test",
    "build": "bun scripts/build.js",
    "build:windows": "bun scripts/build.js --target=bun-windows-x64",
    "telemetry:on": "node src/main.js --telemetry on",
    "telemetry:off": "node src/main.js --telemetry off",
    "dirt3": "node src/main.js --launch-dirt3 --open"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jakubprill/codriver"
  }
}
